{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "hostname": "127.0.0.1",
            "port": 9003
        },
        {
            "name": "Debug current PHP script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "runtimeExecutable": "C:\\PHP\\php.exe",
            "runtimeArgs": [
                "-dxdebug.start_with_request=yes"
            ],
            "port": 9003
        }
    ]
}
